<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The server targets net10.0 only, so its tests do too. -->
    <TargetFramework>$(GatehouseAppTargetFramework)</TargetFramework>
    <RootNamespace>Gatehouse.Server.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- These tests host a real Kestrel on both sides of the gateway rather than using
       TestServer. That is the whole point: TestServer bypasses Kestrel, and Kestrel's output
       buffering is precisely the thing a streaming regression would hide behind. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gatehouse.Core\Gatehouse.Core.csproj" />
    <ProjectReference Include="..\..\src\Gatehouse.Providers.OpenAI\Gatehouse.Providers.OpenAI.csproj" />
    <ProjectReference Include="..\..\src\Gatehouse.Server\Gatehouse.Server.csproj" />
    <ProjectReference Include="..\..\src\Gatehouse.Storage.Sqlite\Gatehouse.Storage.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

</Project>
