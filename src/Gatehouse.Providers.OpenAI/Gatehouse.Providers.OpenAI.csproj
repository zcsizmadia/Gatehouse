<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(GatehouseLibraryTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Gatehouse.Providers.OpenAI</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Gatehouse.Providers.OpenAI</PackageId>
    <Description>
      OpenAI-compatible provider for Gatehouse. Serves any upstream that speaks the OpenAI
      chat completions API, which in practice covers OpenAI, Azure OpenAI, Ollama, vLLM and
      Foundry Local.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gatehouse.Core\Gatehouse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gatehouse.Server.Tests" />
  </ItemGroup>

</Project>
