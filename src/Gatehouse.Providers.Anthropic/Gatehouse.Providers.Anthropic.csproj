<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(GatehouseLibraryTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Gatehouse.Providers.Anthropic</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Gatehouse.Providers.Anthropic</PackageId>
    <Description>
      Anthropic Messages API provider for Gatehouse. Hand-written rather than built on the
      official SDK so that the build stays NativeAOT-compatible and so that the cache-token
      fields invoice reconciliation depends on are preserved.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gatehouse.Core\Gatehouse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gatehouse.Providers.Tests" />
    <InternalsVisibleTo Include="Gatehouse.Server.Tests" />
  </ItemGroup>

</Project>
